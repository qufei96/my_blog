<div class="pagination">
  <% if (page.prev) { %>
    <a href="<%- page.prev_link %>" class="prev">
      <i class="fas fa-chevron-left"></i> 上一页
    </a>
  <% } else { %>
    <span class="prev disabled">
      <i class="fas fa-chevron-left"></i> 上一页
    </span>
  <% } %>

  <div class="page-numbers">
    <% if (page.prev && page.prev > 1) { %>
      <%- link_to(site.path, '1') %>
      <% if (page.prev > 2) { %>
        <span class="dots">...</span>
      <% } %>
    <% } %>

    <% for (var i = page.start; i <= page.end; i++) { %>
      <% if (i === page.current) { %>
        <span class="current"><%= i %></span>
      <% } else { %>
        <%- link_to(site.path + (i === 1 ? '' : '/page/' + i), i) %>
      <% } %>
    <% } %>

    <% if (page.next && page.next < page.total) { %>
      <% if (page.next < page.total - 1) { %>
        <span class="dots">...</span>
      <% } %>
      <%- link_to(site.path + '/page/' + page.total, page.total) %>
    <% } %>
  </div>

  <% if (page.next) { %>
    <a href="<%- page.next_link %>" class="next">
      下一页 <i class="fas fa-chevron-right"></i>
    </a>
  <% } else { %>
    <span class="next disabled">
      下一页 <i class="fas fa-chevron-right"></i>
    </span>
  <% } %>
</div>