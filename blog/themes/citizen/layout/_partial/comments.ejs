<% if (theme.custom.post.enable_comment && theme.external.comment.enable) { %>
  <div id="waline" class="comments-section"></div>

  <!-- Waline Script -->
  <script src="https://cdn.jsdelivr.net/npm/@waline/client@2.14.0/dist/Waline.min.js"></script>

  <script>
    new Waline({
      el: '#waline',
      serverURL: '<%= theme.external.comment.waline.server_url %>',
      path: window.location.pathname,
      lang: 'zh-CN',
      locale: {
        placeholder: '<%= theme.external.comment.waline.placeholder || "留下您的评论..." %>',
      },
      emoji: ['https://unpkg.com/@waline/emojis@1.0.0/weibo', 'https://unpkg.com/@waline/emojis@1.0.0/bilibili', 'https://unpkg.com/@waline/emojis@1.0.0/tieba'],
      dark: 'html[data-theme=dark]',
      highlight: true,
      copyright: true,
      requiredMeta: ['nick', 'mail'],
      login: 'force',
      wordLimit: 200,
      pageSize: 10,
      imageUploader: true,
      search: true,
      reaction: true,
      reactionTitle: '点赞',
      reactionEmoji: ['👍', '👏', '🎉', '❤️', '😄'],
    });
  </script>

  <!-- Comments Styles -->
  <style>
    .comments-section {
      margin-top: 2rem;
      padding: 1.5rem;
      background-color: white;
      border: 1px solid #c9c4b8;
      border-radius: 5px;
    }

    #waline .vcount {
      color: #8b8680;
    }

    #waline .vsubmit {
      background-color: #a0522d;
      color: white;
      border: none;
      padding: 0.75rem 2rem;
      border-radius: 5px;
      font-size: 1rem;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    #waline .vsubmit:hover {
      background-color: #8b4513;
    }

    #waline .vwrap {
      border: 1px solid #c9c4b8;
      border-radius: 5px;
      background-color: #fffdf7;
    }

    #waline .vheader .vinput {
      border: 1px solid #c9c4b8;
      border-radius: 3px;
      padding: 0.5rem;
    }

    #waline .vcontrol .vbtn {
      background-color: #a0522d;
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 3px;
      cursor: pointer;
    }

    #waline .vbtn:hover {
      background-color: #8b4513;
    }

    #waline .vlist .vcard {
      border-bottom: 1px solid #c9c4b8;
      padding: 1rem 0;
    }

    #waline .vcontent {
      color: #2c2c2c;
      line-height: 1.8;
    }

    #waline .vquote {
      color: #8b8680;
      font-size: 0.9rem;
      margin-top: 0.5rem;
      padding-left: 1rem;
      border-left: 3px solid #a0522d;
    }

    #waline .vreply {
      color: #8b8680;
      font-size: 0.9rem;
      margin-top: 0.5rem;
    }

    #waline .vempty {
      text-align: center;
      color: #8b8680;
      padding: 2rem 0;
    }

    #waline .vmark {
      background-color: rgba(160, 82, 45, 0.1);
      border-radius: 3px;
      padding: 0.2rem 0.4rem;
    }

    #waline .vemoji {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      max-width: 300px;
    }

    #waline .vemoji li {
      font-size: 1.5rem;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    #waline .vemoji li:hover {
      transform: scale(1.2);
    }

    #waline .vpower {
      color: #8b8680;
      font-size: 0.8rem;
      text-align: center;
      margin-top: 1rem;
    }

    #waline .vloading {
      text-align: center;
      color: #8b8680;
      padding: 1rem;
    }

    /* Responsive styles for comments */
    @media (max-width: 768px) {
      .comments-section {
        padding: 1rem;
      }

      #waline .vsubmit {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
      }
    }
  </style>
<% } else { %>
  <div class="no-comments">
    <p>评论功能暂未启用</p>
  </div>
<% } %>